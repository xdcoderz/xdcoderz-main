# XDCoderz shared service identity
XDCODERZ_SERVICE_EMAIL=grow.xdcoderz@gmail.com
NEWSLETTER_FROM_EMAIL=grow.xdcoderz@gmail.com

# Newsletter provider
# local works with no external API and writes to data/newsletter-subscribers.jsonl.
# brevo is the recommended free-friendly provider for production.
# Supported values: local, brevo, buttondown, mailchimp
NEWSLETTER_PROVIDER=local

# Brevo
# Free tier: useful for early lists and weekly sends.
BREVO_API_KEY=
BREVO_LIST_ID=

# Buttondown
# Simple developer-style newsletter; API access is available on free plans.
BUTTONDOWN_API_KEY=

# Mailchimp
# Free tier is tighter; use only if you already prefer Mailchimp.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
