# XDCoderz shared service identity
XDCODERZ_SERVICE_EMAIL=grow.xdcoderz@gmail.com
CONTACT_FROM_EMAIL="XDCoderz <hello@xdcoderz.xyz>"
CONTACT_REPLY_TO_EMAIL=grow.xdcoderz@gmail.com
NEWSLETTER_FROM_EMAIL="XDCoderz <hello@xdcoderz.xyz>"

# Newsletter provider
# local works with no external API and writes to data/newsletter-subscribers.jsonl.
# resend sends confirmation + admin notification emails; use Supabase later for durable subscriber storage.
# Supported values: local, resend, brevo, buttondown, mailchimp
NEWSLETTER_PROVIDER=resend

# Resend
RESEND_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access (comma-separated Supabase Auth emails)
ADMIN_EMAILS=grow.xdcoderz@gmail.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=xdcoderz
SENTRY_AUTH_TOKEN=
ENABLE_SENTRY_TEST_ROUTE=false

# Brevo
# Free tier: useful for early lists and weekly sends.
BREVO_API_KEY=
BREVO_LIST_ID=

# Buttondown
# Simple developer-style newsletter; API access is available on free plans.
BUTTONDOWN_API_KEY=

# Mailchimp
# Free tier is tighter; use only if you already prefer Mailchimp.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
